{
  "name": "message-reporting",
  "version": "0.2.0",
  "description": "Browser SDK for error monitoring, with CID initialization and reporting policy checks.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Silent-12/message-reporting.git"
  },
  "homepage": "https://github.com/Silent-12/message-reporting#readme",
  "bugs": {
    "url": "https://github.com/Silent-12/message-reporting/issues"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "sdk",
    "reporting",
    "browser",
    "typescript",
    "monitoring",
    "fetch"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && tsup && tsup --config tsup.iife.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.mjs\" \"*.cjs\"",
    "format:write": "prettier --write \"src/**/*.ts\" \"tests/**/*.mjs\" \"*.cjs\"",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format && npm test",
    "release:pack": "npm run check && npm pack --ignore-scripts",
    "precommit": "npm run lint && npm run format",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "esbuild": "^0.27.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tsup": "^9.0.0",
    "typescript": "6.0.3"
  }
}
