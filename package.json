{
  "name": "message-reporting",
  "version": "0.2.0",
  "description": "Browser SDK for error monitoring, with CID initialization and reporting policy checks.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "sdk",
    "reporting",
    "browser",
    "typescript",
    "monitoring",
    "fetch"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && tsup && tsup --config tsup.iife.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.mjs\" \"*.cjs\"",
    "format:write": "prettier --write \"src/**/*.ts\" \"tests/**/*.mjs\" \"*.cjs\"",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format && npm test",
    "precommit": "npm run lint && npm run format",
    "prepare": "husky",
    "prepublishOnly": "npm run check",
    "release": "npm publish",
    "registry:official": "npm config set registry https://registry.npmjs.org/",
    "registry:mirror": "npm config set registry https://registry.npmmirror.com/"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tsup": "^8.3.5",
    "typescript": "5.5.4"
  }
}
